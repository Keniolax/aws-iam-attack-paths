{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:REPLACE_WITH_ACCOUNT_ID:log-group:/aws/lambda/REPLACE_WITH_FUNCTION_NAME:*"
    }
  ]
}
